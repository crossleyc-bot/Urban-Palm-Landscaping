# ────────────────────────────────────────────────────────────────────────────
# 05-s3-backup.config
#
# Sets up scheduled SQLite database backups to S3:
#   1. Installs sqlite3 CLI (needed for safe .backup command)
#   2. Deploys the backup script
#   3. Creates a cron job that runs the backup every 6 hours
#   4. Grants the EC2 instance permission to write to the backup bucket
#
# REQUIRED: Set the S3_BACKUP_BUCKET environment variable in your EB
# environment (Console → Configuration → Software → Environment properties)
# to the name of your S3 bucket (e.g. "urbanpalm-backups").
# ────────────────────────────────────────────────────────────────────────────

packages:
  yum:
    sqlite: []

files:
  "/etc/cron.d/urbanpalm-backup":
    mode: "000644"
    owner: root
    group: root
    content: |
      SHELL=/bin/bash
      # Run backup every 6 hours at minute 15
      15 */6 * * * root /usr/local/bin/urbanpalm-backup.sh >> /var/log/urbanpalm-backup.log 2>&1
      # Keep the newline above — cron requires a trailing newline

  "/usr/local/bin/urbanpalm-backup.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Wrapper that sources EB environment variables then runs the backup.
      set -euo pipefail

      # Load environment variables set in the EB console / .ebextensions
      if [ -f /opt/elasticbeanstalk/deployment/env ]; then
        source <(jq -r 'to_entries | .[] | "export \(.key)=\(.value|@sh)"' \
          /opt/elasticbeanstalk/deployment/env 2>/dev/null) || true
      fi

      # Fallback: try the env file used by newer AL2023 platforms
      if [ -z "${S3_BACKUP_BUCKET:-}" ] && [ -f /var/app/staging/.env ]; then
        set -a
        source /var/app/staging/.env
        set +a
      fi

      # Source environment from the EB platform's env.vars file (AL2023)
      if [ -z "${S3_BACKUP_BUCKET:-}" ]; then
        for f in /opt/elasticbeanstalk/deployment/env.list \
                 /opt/elasticbeanstalk/deployment/custom_env_var; do
          if [ -f "$f" ]; then
            while IFS='=' read -r key val; do
              export "$key"="$val"
            done < "$f"
          fi
        done
      fi

      exec /var/app/current/scripts/backup-db-to-s3.sh

container_commands:
  01_chmod_backup:
    command: "chmod +x scripts/backup-db-to-s3.sh"
  02_run_initial_backup:
    command: "/usr/local/bin/urbanpalm-backup.sh || echo 'Initial backup skipped (bucket may not be configured yet).'"
    leader_only: true
