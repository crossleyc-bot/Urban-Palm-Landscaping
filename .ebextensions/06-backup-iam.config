# ────────────────────────────────────────────────────────────────────────────
# 06-backup-iam.config
#
# Adds an IAM instance profile policy granting the EC2 instance permission
# to read/write to the S3 backup bucket.
#
# NOTE: This creates an inline policy on the EB instance profile role.
# If your EB instance role already has broad S3 access, this file is
# optional — but it's good practice to scope permissions explicitly.
#
# The bucket name is referenced via the S3_BACKUP_BUCKET env var, but since
# CloudFormation can't resolve EB env vars directly, you must ALSO update
# the bucket name in the Resource ARNs below if you change it.
# ────────────────────────────────────────────────────────────────────────────

Resources:
  BackupBucketPolicy:
    Type: AWS::IAM::ManagedPolicy
    Properties:
      ManagedPolicyName: urbanpalm-s3-backup-access
      Description: "Allow EB instances to back up SQLite DB and uploads to S3"
      PolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Sid: S3BackupAccess
            Effect: Allow
            Action:
              - "s3:PutObject"
              - "s3:GetObject"
              - "s3:ListBucket"
              - "s3:DeleteObject"
            Resource:
              - "arn:aws:s3:::urbanpalm-backups"
              - "arn:aws:s3:::urbanpalm-backups/*"
      Roles:
        - "aws-elasticbeanstalk-ec2-role"
