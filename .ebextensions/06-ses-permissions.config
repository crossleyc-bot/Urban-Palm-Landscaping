# ────────────────────────────────────────────────────────────────────────────
# 06-ses-permissions.config
#
# Grants the Elastic Beanstalk EC2 instance role permission to send email
# via Amazon SES. Required for contact form and quote request notifications.
# ────────────────────────────────────────────────────────────────────────────

Resources:
  SESSendEmailPolicy:
    Type: AWS::IAM::ManagedPolicy
    Properties:
      PolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Action:
              - ses:SendEmail
              - ses:SendRawEmail
            Resource: "*"
      Roles:
        - aws-elasticbeanstalk-ec2-role
