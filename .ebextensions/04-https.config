option_settings:
  # HTTPS listener on port 443
  - namespace: aws:elbv2:listener:443
    option_name: ListenerEnabled
    value: "true"
  - namespace: aws:elbv2:listener:443
    option_name: Protocol
    value: HTTPS
  - namespace: aws:elbv2:listener:443
    option_name: SSLCertificateArns
    value: arn:aws:acm:us-east-1:059378383038:certificate/001d6601-1016-4b12-bd6d-1d585e4d4554
  - namespace: aws:elbv2:listener:443
    option_name: SSLPolicy
    value: ELBSecurityPolicy-TLS13-1-2-2021-06
  # Keep HTTP listener for redirect (Nginx handles the 301)
  - namespace: aws:elbv2:listener:default
    option_name: ListenerEnabled
    value: "true"
