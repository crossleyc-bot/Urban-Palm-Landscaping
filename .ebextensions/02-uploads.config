# Ensure upload directories persist across deployments
# Note: For production, consider moving uploads to S3 for durability
commands:
  01_create_upload_dirs:
    command: |
      mkdir -p /var/app/current/server/uploads/{employees,services,inventory,imports,videos,carousel,taxonomy,resources}
      chown -R webapp:webapp /var/app/current/server/uploads 2>/dev/null || true
    ignoreErrors: true
