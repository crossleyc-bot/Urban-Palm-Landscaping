option_settings:
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: NODE_ENV
    value: production
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: PORT
    value: "8080"
  # Ensure npm installs ALL dependencies (including devDependencies like eslint)
  # NPM_CONFIG_PRODUCTION is the correct env var for npm on AL2023
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: NPM_CONFIG_PRODUCTION
    value: "false"
  # ELB health check
  - namespace: aws:elasticbeanstalk:environment:process:default
    option_name: HealthCheckPath
    value: /api/health
