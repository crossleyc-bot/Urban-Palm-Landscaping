option_settings:
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: NODE_ENV
    value: production
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: PORT
    value: "8080"
  # Install devDependencies so vite is available for the build step
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: NPM_USE_PRODUCTION
    value: "false"
  # ELB health check
  - namespace: aws:elasticbeanstalk:environment:process:default
    option_name: HealthCheckPath
    value: /api/health
